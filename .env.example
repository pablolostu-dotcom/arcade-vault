# Arcade Vault — variables de entorno
#
# Copiá este archivo a .env.local y completá los valores reales.
# .env.local NO se versiona: .gitignore ignora todo .env* salvo este ejemplo.


# ─────────────────────────────────────────────────────────────────────────────
# Formulario de contacto (/acerca-de) — SOLO SERVIDOR
#
# Estas tres NO llevan NEXT_PUBLIC_ y no deben llevarlo nunca: son secretos que
# solo existen dentro de la Server Action. Next inyecta en el bundle del cliente
# únicamente las variables con ese prefijo, así que sin él jamás salen del server.
#
# Si RESEND_API_KEY falta en desarrollo, la Server Action entra en modo simulado:
# loguea el mensaje en la consola del servidor y devuelve éxito, sin mandar nada.
# En producción, que falte es un error y el formulario muestra el mensaje de fallo.
# ─────────────────────────────────────────────────────────────────────────────

# Clave de API de Resend — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Dirección que recibe los mensajes del formulario
CONTACT_TO_EMAIL=equipo@ejemplo.com

# Remitente. onboarding@resend.dev funciona sin dominio verificado;
# cambialo cuando tengas uno propio dado de alta en Resend.
CONTACT_FROM_EMAIL=onboarding@resend.dev


# ─────────────────────────────────────────────────────────────────────────────
# Supabase — PÚBLICAS A PROPÓSITO
#
# Estas dos SÍ llevan NEXT_PUBLIC_ y es deliberado: el cliente de browser
# (lib/supabase/client.ts) corre dentro del navegador y no puede funcionar sin
# ellas, así que tienen que viajar en el bundle. Es exactamente lo contrario de
# las tres de Resend de arriba.
#
# No es un descuido de seguridad: la clave publicable solo puede hacer lo que las
# políticas de RLS del proyecto le permitan. Lo que protege una base de Supabase
# es RLS, no esconder esta clave.
#
# La service_role key es otra cosa: saltea RLS por completo y NO entra al repo.
# ─────────────────────────────────────────────────────────────────────────────

# URL del proyecto — Supabase Dashboard › Project Settings › Data API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Clave publicable (la moderna sb_publishable_…, no la anon key JWT heredada)
# Supabase Dashboard › Project Settings › API Keys
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
