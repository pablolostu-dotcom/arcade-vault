# Arcade Vault — variables del formulario de contacto (/acerca-de)
#
# Copiá este archivo a .env.local y completá los valores reales.
# .env.local NO se versiona: .gitignore ignora todo .env* salvo este ejemplo.
#
# Si RESEND_API_KEY falta en desarrollo, la Server Action entra en modo simulado:
# loguea el mensaje en la consola del servidor y devuelve éxito, sin mandar nada.
# En producción, que falte es un error y el formulario muestra el mensaje de fallo.

# Clave de API de Resend — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Dirección que recibe los mensajes del formulario
CONTACT_TO_EMAIL=equipo@ejemplo.com

# Remitente. onboarding@resend.dev funciona sin dominio verificado;
# cambialo cuando tengas uno propio dado de alta en Resend.
CONTACT_FROM_EMAIL=onboarding@resend.dev
